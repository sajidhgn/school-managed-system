# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored and NEVER committed.
# Every value here maps 1:1 to a field on app/core/config.py::Settings.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME="School Management System"
ENVIRONMENT=local                     # local | test | staging | production
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false                        # false = pretty console logs, true = JSON for log aggregators

# --- API ---
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]   # Next.js dev server

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_64_byte_urlsafe_secret

# HS256 in dev, RS256 in production (spec §4.1). Under RS256 the private key signs
# and the public key verifies, so a compromised verifier cannot forge the `org`
# claim -- which in this system is the tenant boundary.
# Generate a pair with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.key
#   openssl rsa -in jwt.key -pubout -out jwt.pub
JWT_ALGORITHM=HS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Session cookies ---
# Tokens ride in httpOnly cookies, never localStorage (spec §4.1).
# COOKIE_SECURE MUST be true anywhere with TLS.
# COOKIE_SAMESITE=none is needed only when the marketing site and the app are on
# different registrable domains, and it REQUIRES COOKIE_SECURE=true.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_COOKIE_NAME=educloud_access
REFRESH_COOKIE_NAME=educloud_refresh

# --- Password policy (spec §4.4) ---
PASSWORD_MIN_LENGTH=10
PASSWORD_MIN_ZXCVBN_SCORE=3           # 0-4; 3 = "safely unguessable"

# --- Account lockout (spec §4.4) ---
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15              # doubles on each subsequent lockout
LOGIN_LOCKOUT_MAX_MINUTES=1440

# --- Redis (permission cache) ---
# Backs `perm:{role_id}:{pv}`. With REDIS_ENABLED=false the app still works --
# permission resolution falls back to Postgres on every request. Correctness is
# unaffected; latency is not.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
PERMISSION_CACHE_TTL_SECONDS=300

# --- Invitations (spec §7) ---
INVITATION_EXPIRE_DAYS=7
INVITATION_MAX_RESENDS=5

# --- Platform super admin (spec §11) ---
# Consumed by `python -m app.cli seed`. The seeder REFUSES to run in production if
# the password is shorter than 16 characters -- this account can read every tenant.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# --- Database ---
# Leave DB_ENABLED=false until the PostgreSQL integration phase.
# The app boots and serves /health without a database when this is false.
DB_ENABLED=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sms_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=school_manage_db
DB_ECHO=false                         # true logs every SQL statement (dev only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# Alembic connects as the schema OWNER (DDL rights); the app connects as the
# restricted POSTGRES_USER above. Keep them different: table owners bypass RLS, so
# one shared role silently disables tenant isolation. Empty = reuse POSTGRES_USER,
# which is only correct for a throwaway database.
MIGRATION_USER=
MIGRATION_PASSWORD=

# --- Email / OTP ---
# console = render to the log, send nothing (default; safe for dev + tests)
# smtp    = actually deliver
EMAIL_BACKEND=console

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Port 587 -> START_TLS=true, USE_TLS=false
# Port 465 -> START_TLS=false, USE_TLS=true
# These are mutually exclusive. (Nodemailer's `secure: true` == SMTP_USE_TLS.)
SMTP_START_TLS=true
SMTP_USE_TLS=false
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=                        # Gmail App Password, NOT your account password
SMTP_TIMEOUT_SECONDS=15

# Must be a real mailbox. A bare display name is rejected by most receiving servers.
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=School Manage

# --- WhatsApp class groups ---
# The API only QUEUES group messages; `python -m app.cli send-whatsapp` sends them.
# console   = log and mark sent (default; safe for dev + tests)
# null      = mark sent, log nothing
# pywhatkit = really post via WhatsApp Web. Desktop only: run the dispatcher on the
#             machine where the school's WhatsApp is logged in to web.whatsapp.com,
#             after `uv sync --extra whatsapp`. Never on a headless server.
WHATSAPP_BACKEND=console
WHATSAPP_PYWHATKIT_WAIT_SECONDS=20
WHATSAPP_DISPATCH_BATCH=50

FRONTEND_URL=http://localhost:3000
EMAIL_LOGO_URL=                       # optional absolute URL for the email header

# --- Trial retention ----------------------------------------------------------
# When a trial ends without a plan the account goes read-only, the owner is emailed,
# warned again TRIAL_DELETION_NOTICE_DAYS before deletion, and after TRIAL_GRACE_DAYS
# the organization and all its data are permanently deleted (`make maintenance`).
TRIAL_GRACE_DAYS=7
TRIAL_DELETION_NOTICE_DAYS=2
