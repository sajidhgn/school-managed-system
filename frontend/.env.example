# Copy to `.env.local`. Never committed.
#
# EVERY VALUE HERE IS SERVER-SIDE ONLY. There is deliberately no NEXT_PUBLIC_* API
# url: the browser never talks to FastAPI directly. It calls this app's BFF proxy at
# /api/bff/*, which attaches the session token server-side, so no token ever reaches
# the browser bundle.

# --- Backend ---
# Where FastAPI listens. The backend's CORS_ORIGINS should point back at :3000.
API_BASE_URL=http://localhost:8000
API_V1_PREFIX=/api/v1

# --- Cookies ---
# This app sets its OWN httpOnly session cookies (educloud_access / educloud_refresh
# for tenants, educloud_platform_* for operators). Set `true` anywhere with HTTPS —
# a session cookie without `Secure` crosses the network in clear text.
COOKIE_SECURE=false

# --- Public site ---
# The address the marketing site is served from, with no trailing slash. Used for
# canonical URLs, sitemap.xml, robots.txt and link previews. Set it in production:
# a wrong value tells search engines the real pages live somewhere else.
SITE_URL=http://localhost:3000

# How visitors reach you. Each is optional; a link whose value is empty is not shown.
# SITE_WHATSAPP powers the floating "Talk on WhatsApp" button and "Book a free demo"
# (international format, e.g. 923001234567); without it, "Book a free demo" uses SITE_EMAIL.
SITE_WHATSAPP=
SITE_EMAIL=
SITE_PHONE=

# --- Public admissions form ---
# Optional. /admissions/<school_id> works without it.
NEXT_PUBLIC_DEFAULT_SCHOOL_ID=
