# Runs the textbook agent (OpenAI) on queued chapters and indexes them in pgvector.
[Unit]
Description=SchoolYar book worker (process-books --watch)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=sms
Group=sms
WorkingDirectory=/var/www/school-managed-system/backend
Environment=TZ=Asia/Karachi
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/www/school-managed-system/backend/.venv/bin/python -m app.cli process-books --watch
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
