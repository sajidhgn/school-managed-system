# frontend/.env.production.local on the VPS (sms.therawbit.ai).
#
#   cp deploy/vps/frontend.env.example frontend/.env.production.local
#   chgrp sms frontend/.env.production.local && chmod 640 frontend/.env.production.local
#
# Read twice: by `npm run build` (Next loads .env.production.local) and by the
# sms-web service (EnvironmentFile=). systemd does not allow comments after a
# value, so keep every comment on its own line.
# PORT and HOSTNAME live in deploy/vps/systemd/sms-web.service.

# The private API on this machine.
API_BASE_URL=http://127.0.0.1:8100
API_V1_PREFIX=/api/v1

# HTTPS everywhere, so session cookies get the Secure flag.
COOKIE_SECURE=true

# The public address, no trailing slash.
SITE_URL=https://sms.therawbit.ai

# Keep the whole site out of search engines (noindex meta tag, X-Robots-Tag header,
# empty sitemap). Rebuild after changing it: next.config.ts reads it at build time.
SITE_NOINDEX=true

# Optional contact links on the public pages; an empty value hides the link.
SITE_WHATSAPP=
SITE_EMAIL=
SITE_PHONE=
