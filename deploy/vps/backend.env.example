# ---------------------------------------------------------------------------
# backend/.env on the VPS (sms.therawbit.ai).
#
#   cp deploy/vps/backend.env.example backend/.env
#   chgrp sms backend/.env && chmod 640 backend/.env
#
# Every CHANGE_ME must be filled in. Copy the secrets from your local backend/.env
# (and backend/.env.live for the database passwords): the live database already
# has its users and their passwords.
# Full reference for every key: backend/.env.example.
# ---------------------------------------------------------------------------

# --- Application ---
# staging, NOT production, for now: production refuses to boot on the mock
# payment gateway (the only one implemented) and its TrustedHost list is still the
# placeholder *.example.com. See docs/operations/deploy-vps.md, "Before production".
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

# --- API (private: 127.0.0.1:8100, reached only by the Next.js BFF) ---
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["https://sms.therawbit.ai"]
FRONTEND_URL=https://sms.therawbit.ai
# nginx -> Next -> API all on this machine; trust X-Forwarded-For only from here.
TRUSTED_PROXY_IPS=["127.0.0.1"]

# --- Security ---
# A NEW value for this server: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Changing it later signs everybody out.
SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- Platform super admin (used by `python -m app.cli seed`) ---
SUPERADMIN_EMAIL=CHANGE_ME
SUPERADMIN_PASSWORD=CHANGE_ME_at_least_16_characters

# --- Database: the PostgreSQL 16 already running on this server ---
DB_ENABLED=true
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=school_manage_db
# The restricted app role (RLS applies to it).
POSTGRES_USER=sms_app
POSTGRES_PASSWORD=CHANGE_ME
# The schema owner, used only by `alembic upgrade head`.
MIGRATION_USER=postgres
MIGRATION_PASSWORD=CHANGE_ME
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- Redis (shared server; the rawbit apps use db 0 and 1) ---
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/5

# --- Email (real delivery: sign-up verification, password resets, invitations) ---
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_START_TLS=true
SMTP_USE_TLS=false
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
EMAIL_FROM_ADDRESS=CHANGE_ME
EMAIL_FROM_NAME=SchoolYar

# --- SMS: no real provider exists yet. `console` would write parents' login codes
# into the server log, so discard instead. ---
SMS_BACKEND=null

# --- WhatsApp through WAHA on this server (deploy/vps/waha.compose.yml) ---
# Not using WhatsApp yet? Set WHATSAPP_BACKEND=null and skip the WAHA steps.
WHATSAPP_BACKEND=waha
WAHA_BASE_URL=http://127.0.0.1:3001
# WAHA reads this same line (docker compose --env-file backend/.env).
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WAHA_API_KEY=CHANGE_ME
WAHA_WEBHOOK_URL=http://127.0.0.1:8100/api/v1/whatsapp/webhook
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WAHA_WEBHOOK_SECRET=CHANGE_ME
WHATSAPP_DEFAULT_COUNTRY_CODE=92

# --- Uploaded files (created by the setup steps, owned by the `sms` user) ---
BOOKS_STORAGE_PATH=/var/lib/sms/books
AVATARS_STORAGE_PATH=/var/lib/sms/avatars

# --- Textbook library, test papers and the diary agent (OpenAI) ---
OPENAI_API_KEY=CHANGE_ME
# Book cover scanning ("Add a book" with AI).
KIE_API_TOKEN=
# The book-worker service does the processing; keep the API out of it.
BOOKS_INLINE_PROCESSING=false
PAPERS_INLINE_GENERATION=false

# --- Payments ---
# mock approves every charge. Acceptable only while nobody pays through the app.
PAYMENT_GATEWAY=mock
